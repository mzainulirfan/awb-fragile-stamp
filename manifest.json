{
  "manifest_version": 3,
  "name": "Shopee AWB Fragile Stamp",
  "description": "Otomatis menambahkan stempel FRAGILE / JANGAN DIBANTING pada label AWB di Seller Centre Shopee.",
  "version": "1.2.0",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shopee AWB Fragile Stamp",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.shopee.co.id/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://seller.shopee.co.id/awbprint*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://seller.shopee.co.id/awbprint*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
